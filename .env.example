# ──────────────────────────────────────────────────────────────────────────────
# Environment Configuration
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# Django
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# Database
POSTGRES_DB=uptimemonitor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Django Channels
CHANNEL_LAYERS_REDIS_URL=redis://redis:6379/3

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@uptimemonitor.local

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Slack
# (configured per-channel, not global)

# Encryption key for AlertChannel.config secrets
FIELD_ENCRYPTION_KEY=your-fernet-key-base64-32-bytes-here

# Flower monitoring UI
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# Sentry (production)
SENTRY_DSN=
